[gd_resource type="Resource" script_class="AbilityData" format=3]

[ext_resource type="Script" path="res://data/ability/ability_data.gd" id="ability"]
[ext_resource type="Resource" path="res://data/trait/warrior.tres" id="warrior"]
[ext_resource type="Resource" path="res://data/trait/passive.tres" id="passive"]
[ext_resource type="Resource" path="res://data/reaction/evasive_step_reaction.tres" id="reaction"]

[resource]
script = ExtResource("ability")
id = "evasive_step"
display_name = "Evasive Step"
required_level = 1
required_trait_ids = Array[String](["warrior"])
required_stance_id = "duelist_stance"
traits = [ExtResource("warrior")]
description = "ขณะอยู่ใน Duelist Stance เมื่อศัตรูโจมตีประชิดพลาด ใช้ Reaction เคลื่อนที่ได้สูงสุด 10 ฟุต"
is_passive = true
traits = [ExtResource("warrior"), ExtResource("passive")]
granted_reactions = [ExtResource("reaction")]

