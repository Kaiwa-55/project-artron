description = "ขณะอยู่ใน Assault Stance ใช้ 1 AP โจมตีประชิด เมื่อโจมตีโดน การโจมตีครั้งถัดไปใส่เป้าหมายเดิมในเทิร์นนี้ได้โบนัสความแม่นยำ +1"
ap_cost = 1
on_hit_next_attack_to_hit_bonus = 1
uses_equipped_weapon_attack = true
required_attack_trait_ids = Array[String](["melee"])
attack_source = 1
