[gd_resource type="Resource" script_class="EventData" format=3 uid="uid://es4q141m7c8y"]

[ext_resource type="Script" uid="uid://w32bv4ws7ufq" path="res://data/event/event_data.gd" id="1"]
[ext_resource type="Script" uid="uid://bvaeeo3eqywqf" path="res://data/event/event_choice.gd" id="2"]
[ext_resource type="Script" uid="uid://tv77tod2hxiq" path="res://data/event/event_condition.gd" id="3"]
[ext_resource type="Script" uid="uid://tj14nr7yv2rr" path="res://data/event/event_effect.gd" id="4"]
[ext_resource type="Resource" uid="uid://buib3ur3rbi6w" path="res://data/event/caravan_search.tres" id="5"]
[ext_resource type="Resource" uid="uid://bm07ftbkjqr5f" path="res://data/encounter/bandit_ambush_event.tres" id="6"]
[ext_resource type="Texture2D" uid="uid://b81onujq6yl8v" path="res://assets/events/strange_caravan_anime.png" id="7"]

[sub_resource type="Resource" id="Choice_search"]
script = ExtResource("2")
text = "Inspect the overturned caravan"
next_event = ExtResource("5")

[sub_resource type="Resource" id="Choice_call"]
script = ExtResource("2")
text = "Call out to anyone inside"
encounter = ExtResource("6")

[sub_resource type="Resource" id="Condition_reflex"]
script = ExtResource("3")
type = 0
key = &"reflex"
required_number = 6.0
failure_reason = "Requires Reflex 6."

[sub_resource type="Resource" id="Effect_discovered"]
script = ExtResource("4")
key = &"discovered_ambush"

[sub_resource type="Resource" id="Choice_tracks"]
script = ExtResource("2")
text = "Study the tracks before approaching"
actor_mode = 1
conditions = Array[ExtResource("3")]([SubResource("Condition_reflex")])
effects = Array[ExtResource("4")]([SubResource("Effect_discovered")])
encounter = ExtResource("6")

[resource]
script = ExtResource("1")
id = &"strange_caravan"
title = "Strange Caravan"
description = "An overturned caravan lies across the road. A faint sound comes from inside."
illustration = ExtResource("7")
choices = Array[ExtResource("2")]([SubResource("Choice_search"), SubResource("Choice_call"), SubResource("Choice_tracks")])
