[resource]
script = ExtResource("skill")
id = "arcane_shield"
display_name = "Arcane Shield"
spell_level = 1
traits = [ExtResource("arcane")]
description = "Cast for 1 AP and 2 Mana to gain +2 Reflex, Fortitude, and Will until the start of your next turn; or use a Reaction when hit for +2 Defense against that attack and 2 Mana. Both uses share a 2-turn cooldown."
mana_cost = 2
ap_cost = 1
cooldown_turns = 2
self_effect = ExtResource("effect")
granted_reactions = Array[ReactionData]([ExtResource("reaction")])
target_mode = 1
target_filter = 1
